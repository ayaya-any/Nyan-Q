{
  "servers": [
    {
      "id": "yaml",
      "name": "YAML Language Server",
      "languageId": "yaml",
      "extensions": ["yaml", "yml"],
      "command": "${app}/lsp/yaml-language-server.exe",
      "args": ["--stdio"],
      "initializationOptions": {
        "yaml": {
          "validate": true,
          "hover": true,
          "completion": true,
          "format": { "enable": true },
          "schemaStore": { "enable": false }
        }
      }
    }
  ]
}
